  {
    "id": "184_model_source",
    "source": "work/grid184_search_adapter/models.py",
    "snapshot": "evidence_documents/07_184_model_source.py",
    "sha256": "31732ec2e617d8948c8e3e25f4ef8fb6e71e511478b86fb7124c055a36c0004c",
    "scope": "Static original checkpoint/source selectors; never execute model code.",
    "line_count": 54,
    "excerpts": [
      {
        "line": 1,
        "text": "\"\"\"Checkpoint-compatible deployment definitions without training-module imports.\"\"\""
      },
      {
        "line": 16,
        "text": "class Factor(nn.Module):"
      },
      {
        "line": 17,
        "text": "    def __init__(self):super().__init__();self.base=Q(42);self.delta=V.RelationalValue('FACTOR')"
      },
      {
        "line": 26,
        "text": "        manifest=json.loads((folder/'deployment_manifest.json').read_text(encoding='utf8'))"
      },
      {
        "line": 31,
        "text": "            for arm in ['STATE4','POWER8','FACTOR']:"
      },
      {
        "line": 32,
        "text": "                p=folder/'models'/f'{arm}_seed{seed}.pt';assert sha(p)==manifest['models'][p.name]"
      },
      {
        "line": 33,
        "text": "                net=Factor() if arm=='FACTOR' else Q(50);net.load_state_dict(torch.load(p,map_location='cpu',weights_only=False)['state_dict']);net.eval();self.nets[arm]=net"
      },
      {
        "line": 34,
        "text": "        assert sha(folder/'normalization.npz')==manifest['normalization_sha256']"
      },
      {
        "line": 40,
        "text": "            self.small('STATE4',np.zeros(50,'f'));self.small('POWER8',np.zeros(50,'f'));self.factor(synthetic)"
      },
      {
        "line": 46,
        "text": "    def factor(self,pub):"
      },
      {
        "line": 47,
        "text": "        with torch.inference_mode():return self.nets['FACTOR'](**pack_one(pub))[0].numpy().copy()"
      },
      {
        "line": 49,
        "text": "        assert mode in ['FACTOR','CONSENSUS'];scores={};delegated=mode=='FACTOR';g=np.clip((raw-self.norm['mean41'])/self.norm['scale41'],-20,20).astype('f')"
      },
      {
        "line": 50,
        "text": "        if mode=='CONSENSUS':"
      },
