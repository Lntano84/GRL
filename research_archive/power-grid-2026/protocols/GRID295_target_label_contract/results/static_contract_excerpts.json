        "line": 11,
        "text": "        self.cost=cost;self.gain_scale=gain_scale"
      },
      {
        "line": 19,
        "text": "        return np.clip((self.case['states'][self.position]-self.mean)/self.scale,-20,20).astype(np.float32)"
      },
      {
        "line": 34,
        "text": "            value=(self.case['gains'][j]-self.cost*self.case['queries'][j])/self.gain_scale"
      },
      {
        "line": 35,
        "text": "            self.position+=1;self.done=self.position==len(self.case['queries'])"
      },
      {
        "line": 36,
        "text": "        info=dict(batches=self.position,paid_queries=int(self.case['queries'][:self.position].sum()),"
      },
      {
