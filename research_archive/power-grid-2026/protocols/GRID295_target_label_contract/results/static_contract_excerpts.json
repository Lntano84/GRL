      {
        "line": 1,
        "text": "\"\"\"Finite saved-feedback local search. Actions0=stop,1=purchase next64.\"\"\""
      },
      {
        "line": 9,
        "text": "    def __init__(self,cases,mean,scale,cost,gain_scale):"
