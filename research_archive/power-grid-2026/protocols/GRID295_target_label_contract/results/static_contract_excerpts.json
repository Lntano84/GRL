    "sha256": "77292ab049d2bc3966324001555265e139a1b33666f261f9ac4d1b896549c3bb",
    "role": "Reuse original operating-cost fields and units; not redefining labels.",
    "line_count": 47,
    "excerpts": [
      {
        "line": 1,
        "text": "\"\"\"Passive operational metrics; never feed these evaluation fields back into search.\"\"\""
      },
      {
        "line": 3,
        "text": "from grid2op.Reward import AlertReward, L2RPNSandBoxScore, _AlertTrustScore, _NewRenewableSourcesUsageScore"
      },
      {
        "line": 9,
        "text": "def operational_other_rewards():"
      },
      {
        "line": 10,
        "text": "    # Preserve the native alert auxiliary reward, add exactly the score-helper component names."
      },
      {
        "line": 11,
        "text": "    return {\"alert\":AlertReward,"
      },
      {
        "line": 12,
        "text": "            f\"{PREFIX}_grid_operational_cost\":L2RPNSandBoxScore,"
      },
      {
        "line": 17,
        "text": "def public_cost_ledger(obs,env,previous_curtailed_mw):"
      },
      {
        "line": 18,
        "text": "    \"\"\"Reconcile the installed reward using current/previous public observations."
      },
      {
        "line": 20,
        "text": "    Grid2Op 1.12.5 L2RPNSandBoxScore uses -env._sum_curtailment_mw,"
      },
      {
        "line": 21,
        "text": "    which baseEnv computes as the change in total curtailment, not its level."
      },
      {
        "line": 22,
        "text": "    Retain the physical curtailment level separately; do not confuse this reward"
      },
      {
        "line": 23,
        "text": "    convention with total curtailed energy or feed the ledger back into actions."
      },
      {
        "line": 26,
        "text": "    marginal=float(np.max(env.gen_cost_per_MW[np.asarray(obs.gen_p)>0]))"
      },
      {
        "line": 28,
        "text": "    redisp=float(np.abs(obs.actual_dispatch).sum(dtype=np.float64))*dt"
      },
      {
        "line": 29,
        "text": "    current_curtailed_mw=float(obs.curtailment_mw.sum(dtype=np.float64))"
      },
      {
        "line": 30,
        "text": "    curtailed=current_curtailed_mw*dt"
      },
      {
        "line": 31,
        "text": "    delta_curtailed=(current_curtailed_mw-float(previous_curtailed_mw))*dt"
      },
      {
        "line": 32,
        "text": "    storage=float(np.abs(obs.storage_power).sum(dtype=np.float64))*dt"
      },
      {
        "line": 33,
        "text": "    return {\"marginal_cost\":marginal,\"losses_mwh\":losses,\"redispatch_mwh\":redisp,"
      },
      {
        "line": 34,
        "text": "            \"curtailed_mwh\":curtailed,\"previous_curtailed_mw\":float(previous_curtailed_mw),"
      },
      {
        "line": 35,
        "text": "            \"current_curtailed_mw\":current_curtailed_mw,\"curtailment_delta_mwh\":delta_curtailed,"
      },
      {
        "line": 36,
        "text": "            \"storage_throughput_mwh\":storage,"
      },
      {
        "line": 37,
        "text": "            \"recomputed_raw_cost\":marginal*(losses+redisp+delta_curtailed+storage)}"
      },
      {
        "line": 40,
        "text": "def cost_rounding_tolerance(obs,env):"
      },
      {
        "line": 41,
        "text": "    # The official reward sums backend values in float32; the independent ledger uses"
      },
      {
        "line": 43,
        "text": "    # pairwise-summation scale before any formal smoke result is available."
      },
      {
        "line": 45,
        "text": "                  [\"gen_p\",\"load_p\",\"actual_dispatch\",\"curtailment_mw\",\"storage_power\"])"
      },
      {
        "line": 46,
        "text": "    price=float(np.max(env.gen_cost_per_MW[np.asarray(obs.gen_p)>0]))"
      }
    ]
  }
