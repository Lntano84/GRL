<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="FRAME方法流程" id="FRAME-main"><mxGraphModel dx="1600" dy="740" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="740"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="input" value="&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;输入&lt;/b&gt;&lt;br/&gt;当前状态 s&lt;br/&gt;基础动作 b&lt;br/&gt;候选序列 O&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#A5AFB8;fontColor=#263846;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="320" width="180" height="140" /></mxCell><mxCell id="cache" value="&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;候选仿真与结果缓存&lt;/b&gt;&lt;br/&gt;共享本次搜索的反馈 · 每个代表最多仿真一次&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F6F4;strokeColor=#487C73;fontColor=#263846;fontFamily=Microsoft YaHei;fontSize=18;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="280" y="125" width="1050" height="85" /></mxCell><mxCell id="prefix" value="&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;01  前缀筛查&lt;/b&gt;&lt;br/&gt;评估前 min(p, M) 个候选&lt;br/&gt;保存仿真结果&lt;br/&gt;记录前缀最佳动作&lt;br/&gt;按负载率选择后续分支&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4FA;strokeColor=#6D89A8;fontColor=#263846;fontFamily=Microsoft YaHei;fontSize=17;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="280" y="280" width="280" height="225" /></mxCell><mxCell id="verify" value="&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;02  分批核查&lt;/b&gt;&lt;br/&gt;每批追加至多 h 个候选&lt;br/&gt;更新最佳动作与无改进批数&lt;br/&gt;核查分支：最低查询量与停滞条件&lt;br/&gt;扩展分支：负载率或停滞条件&lt;br/&gt;候选耗尽时结束全局搜索&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1ED;strokeColor=#487C73;fontColor=#263846;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="280" width="360" height="225" /></mxCell><mxCell id="local" value="&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;03  同站补查&lt;/b&gt;&lt;br/&gt;检查分支与动作变化条件&lt;br/&gt;固定最佳动作所属变电站&lt;br/&gt;评估该站尚未查询的候选&lt;br/&gt;更新最佳动作，只补查一次&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4FA;strokeColor=#6D89A8;fontColor=#263846;fontFamily=Microsoft YaHei;fontSize=16;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1040" y="280" width="290" height="225" /></mxCell><mxCell id="output" value="&lt;div style=&quot;line-height:1.6&quot;&gt;&lt;b style=&quot;font-size:22px&quot;&gt;输出&lt;/b&gt;&lt;br/&gt;最佳已评估动作&lt;br/&gt;无合格候选则返回空&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#A5AFB8;fontColor=#263846;fontFamily=Microsoft YaHei;fontSize=14;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1390" y="320" width="175" height="140" /></mxCell><mxCell id="e-input" value="" edge="1" parent="1" source="input" target="prefix" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526571;fontFamily=Microsoft YaHei;fontSize=16;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-prefix" value="" edge="1" parent="1" source="prefix" target="verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526571;fontFamily=Microsoft YaHei;fontSize=16;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-verify" value="" edge="1" parent="1" source="verify" target="local" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526571;fontFamily=Microsoft YaHei;fontSize=16;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-local" value="" edge="1" parent="1" source="local" target="output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526571;fontFamily=Microsoft YaHei;fontSize=16;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="bypass" value="未触发同站补查" edge="1" parent="1" source="verify" target="output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526571;fontFamily=Microsoft YaHei;fontSize=16;exitX=0.5;exitY=1;entryX=0.5;entryY=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="800" y="560" /><mxPoint x="1477.5" y="560" /></Array></mxGeometry></mxCell><mxCell id="feedback-prefix" value="" edge="1" parent="1" source="prefix" target="cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526571;fontFamily=Microsoft YaHei;fontSize=16;exitX=0.5;exitY=0;entryX=0.13333333333333333;entryY=1;dashed=1;startArrow=block;strokeColor=#77958D;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="feedback-verify" value="" edge="1" parent="1" source="verify" target="cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526571;fontFamily=Microsoft YaHei;fontSize=16;exitX=0.5;exitY=0;entryX=0.49523809523809526;entryY=1;dashed=1;startArrow=block;strokeColor=#77958D;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="feedback-local" value="" edge="1" parent="1" source="local" target="cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#526571;fontFamily=Microsoft YaHei;fontSize=16;exitX=0.5;exitY=0;entryX=0.861904761904762;entryY=1;dashed=1;startArrow=block;strokeColor=#77958D;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="title" value="FRAME：反馈驱动的拓扑搜索" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=28;fontColor=#263846;"><mxGeometry as="geometry" x="45" y="15" width="1100" height="40" /></mxCell><mxCell id="subtitle" value="根据仿真反馈控制搜索深度，按变电站信息补查相关候选" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#263846;"><mxGeometry as="geometry" x="45" y="62" width="1200" height="40" /></mxCell><mxCell id="params" value="p = 128　 h = 64　 q_min = 256　 L = 2　 ρ_safe = 0.9" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#263846;"><mxGeometry as="geometry" x="280" y="680" width="1050" height="40" /></mxCell></root></mxGraphModel></diagram></mxfile>