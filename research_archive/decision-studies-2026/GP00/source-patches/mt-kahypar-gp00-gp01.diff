@@ -162,6 +287,73 @@ void computeEdgeMetadataFromModel(const ds::StaticGraph& graph, const Context& c
       predictEdgesDynamicSize(graph, context, global_features, n1_features, skip_comm_1, first_edge, n, params_row, buffer, metadata);
     }
   });
+
+  // GP01 score replay deliberately runs the original feature/model path above,
+  // then replaces only EdgeMetadata. This keeps the scoring call and random
+  // path identical during the injection audit; original graph edge weights
+  // and all later coarsening/refinement logic remain untouched.
+  const char* gp01_input = std::getenv("MKH_GP01_SCORE_FILE");
+  const char* gp01_export = std::getenv("MKH_GP01_EXPORT_SCORES");
+  if (gp01_input != nullptr && gp01_input[0] != '\0' &&
+      gp01_export != nullptr && gp01_export[0] != '\0') {
+    throw std::runtime_error("Set only one of MKH_GP01_SCORE_FILE and MKH_GP01_EXPORT_SCORES");
+  }
+  if (gp01_input != nullptr && gp01_input[0] != '\0') {
+    const std::vector<EdgeMetadata> replayed = readGp01Ratings(gp01_input, graph);
+    for (HyperedgeID edge_id = 0; edge_id < graph.initialNumEdges(); ++edge_id) {
+      metadata[edge_id] = replayed[edge_id];
+    }
+  } else if (gp01_export != nullptr && gp01_export[0] != '\0') {
+    writeGp01Ratings(gp01_export, graph, metadata);
+  }
+
+  if (const char* audit_path = std::getenv("MKH_GP01_AUDIT_LOG");
+      audit_path != nullptr && audit_path[0] != '\0') {
+    std::ofstream audit(audit_path, std::ios::app);
+    if (!audit) throw std::runtime_error(std::string("Cannot open GP01 audit log: ") + audit_path);
+    audit << "MODEL,-1,-1," << context.partition.k << ',' << graph.initialNumNodes() << ','
+          << graph.initialNumEdges() << ",-1,"
+          << ((gp01_input != nullptr && gp01_input[0] != '\0') ? "replay" : "model") << '\n';
+  }
+
+  // Optional GP00 audit dump. This runs only when explicitly enabled and is
+  // read-only: the model inputs and metadata used by the coarsener above have
+  // already been produced, and the dump recomputes feature rows for export.
+  if (const char* dump_path = std::getenv("MKH_GP00_DUMP_FEATURES");
+      dump_path != nullptr && dump_path[0] != '\0') {
+    std::ofstream dump(dump_path);
+    if (!dump) {
+      throw std::runtime_error(std::string("Cannot open GP00 feature dump: ") + dump_path);
+    }
+    dump << "edge_id,source,target,k,n_nodes,skip_comm_1";
+    for (size_t i = 0; i < MEANS.size(); ++i) dump << ",raw_f" << std::setw(2) << std::setfill('0') << i;
+    for (size_t i = 0; i < MEANS.size(); ++i) dump << ",normalized_f" << std::setw(2) << std::setfill('0') << i;
+    dump << ",prediction\n" << std::setfill(' ') << std::setprecision(std::numeric_limits<float>::max_digits10);
+    for (HyperedgeID he = 0; he < graph.initialNumEdges(); ++he) {
+      HypernodeID source = graph.edgeSource(he);
+      HypernodeID target = graph.edgeTarget(he);
+      HypernodeID u = source;
+      HypernodeID v = target;
+      const N1Features* u_f = &n1_features[u];
+      const N1Features* v_f = &n1_features[v];
+      if (u_f->degree < v_f->degree || (u_f->degree == v_f->degree && u < v)) {
+        std::swap(u, v);
+        std::swap(u_f, v_f);
+      }
+      const EdgeFeatures edge = computeEdgeFeatures(graph, context, u, *u_f, v, *v_f, skip_comm_1);
+      float raw[32];
+      MapFeaturesForEdge::map_features(global_features, *u_f, *v_f, edge, raw);
+      dump << he << ',' << source << ',' << target << ',' << context.partition.k << ','
+           << graph.initialNumNodes() << ',' << static_cast<int>(skip_comm_1);
+      for (float value : raw) dump << ',' << value;
+      for (size_t i = 0; i < MEANS.size(); ++i) dump << ',' << ((raw[i] - MEANS[i]) / STDEVS[i]);
+      dump << ',' << metadata[he] << '\n';
+    }
+    dump.close();
+    if (!dump) {
+      throw std::runtime_error(std::string("Failed writing GP00 feature dump: ") + dump_path);
+    }
+  }
   free_params(params_row);
 
   timer.stop_timer("inference");
