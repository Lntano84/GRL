+std::vector<EdgeMetadata> readGp01Ratings(const char* path, const ds::StaticGraph& graph) {
+  std::ifstream input(path);
+  if (!input) {
+    throw std::runtime_error(std::string("Cannot open GP01 score file: ") + path);
+  }
+  std::string line;
+  if (!std::getline(input, line)) {
+    throw std::runtime_error("GP01 score file has an invalid header");
+  }
+  if (!line.empty() && line.back() == '\r') line.pop_back();
+
+  std::vector<EdgeMetadata> scores(graph.initialNumEdges(), 0.0f);
+  if (line == "source,target,score") {
+    std::map<std::pair<HypernodeID, HypernodeID>, std::vector<HyperedgeID>> arcs_by_edge;
+    for (HyperedgeID edge_id = 0; edge_id < graph.initialNumEdges(); ++edge_id) {
+      const HypernodeID source = graph.edgeSource(edge_id);
+      const HypernodeID target = graph.edgeTarget(edge_id);
+      arcs_by_edge[std::make_pair(std::min(source, target), std::max(source, target))].push_back(edge_id);
+    }
+    for (const auto& entry : arcs_by_edge) {
+      const auto& arcs = entry.second;
+      if (arcs.size() != 2 || graph.edgeSource(arcs[0]) != graph.edgeTarget(arcs[1]) ||
+          graph.edgeTarget(arcs[0]) != graph.edgeSource(arcs[1])) {
+        throw std::runtime_error("GP01 graph does not contain exactly two opposite arcs per edge");
+      }
+    }
+    std::map<std::pair<HypernodeID, HypernodeID>, bool> seen_edges;
+    HyperedgeID rows = 0;
+    while (std::getline(input, line)) {
+      if (!line.empty() && line.back() == '\r') line.pop_back();
+      std::istringstream row(line);
+      std::string source_text, target_text, score_text, extra;
+      if (!std::getline(row, source_text, ',') || !std::getline(row, target_text, ',') ||
+          !std::getline(row, score_text, ',') || std::getline(row, extra, ',')) {
+        throw std::runtime_error("GP01 undirected score row must have exactly three CSV fields");
+      }
+      const HypernodeID source = static_cast<HypernodeID>(std::stoull(source_text));
+      const HypernodeID target = static_cast<HypernodeID>(std::stoull(target_text));
+      if (source >= graph.initialNumNodes() || target >= graph.initialNumNodes() || source == target) {
+        throw std::runtime_error("GP01 keyed score has an invalid edge endpoint");
+      }
+      const auto key = std::make_pair(std::min(source, target), std::max(source, target));
+      const float score = std::stof(score_text);
+      const auto found = arcs_by_edge.find(key);
+      if (found == arcs_by_edge.end() || seen_edges[key]) {
+        throw std::runtime_error("GP01 keyed score has a missing or duplicate edge key");
+      }
+      if (!std::isfinite(score) || score < 0.0f || score > 1.0f) {
+        throw std::runtime_error("GP01 score must be finite and in [0, 1]");
+      }
+      for (HyperedgeID edge_id : found->second) scores[edge_id] = score;
+      seen_edges[key] = true;
+      ++rows;
+    }
+    if (rows != arcs_by_edge.size()) {
+      throw std::runtime_error("GP01 keyed score file does not cover every undirected edge");
+    }
+    return scores;
+  }
+  if (line != "edge_id,source,target,score") {
+    throw std::runtime_error("GP01 score file has an invalid header");
+  }
+
+  std::vector<bool> seen(graph.initialNumEdges(), false);
+  HyperedgeID rows = 0;
+  while (std::getline(input, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    std::istringstream row(line);
+    std::string edge_id_text, source_text, target_text, score_text, extra;
+    if (!std::getline(row, edge_id_text, ',') || !std::getline(row, source_text, ',') ||
+        !std::getline(row, target_text, ',') || !std::getline(row, score_text, ',') ||
+        std::getline(row, extra, ',')) {
+      throw std::runtime_error("GP01 score row must have exactly four CSV fields");
+    }
+    const HyperedgeID edge_id = static_cast<HyperedgeID>(std::stoull(edge_id_text));
+    const HypernodeID source = static_cast<HypernodeID>(std::stoull(source_text));
+    const HypernodeID target = static_cast<HypernodeID>(std::stoull(target_text));
+    const float score = std::stof(score_text);
+    if (edge_id >= graph.initialNumEdges() || seen[edge_id]) {
+      throw std::runtime_error("GP01 score file has an out-of-range or duplicate edge_id");
+    }
+    if (source != graph.edgeSource(edge_id) || target != graph.edgeTarget(edge_id)) {
+      throw std::runtime_error("GP01 score arc endpoints do not match the current graph");
+    }
+    if (!std::isfinite(score) || score < 0.0f || score > 1.0f) {
+      throw std::runtime_error("GP01 score must be finite and in [0, 1]");
+    }
+    scores[edge_id] = score;
+    seen[edge_id] = true;
+    ++rows;
+  }
+  if (rows != graph.initialNumEdges()) {
+    throw std::runtime_error("GP01 score file does not contain every directed arc");
+  }
+  return scores;
+}
+
+void writeGp01Ratings(const char* path, const ds::StaticGraph& graph,
+                      const vec<EdgeMetadata>& metadata) {
+  std::ofstream output(path);
+  if (!output) {
+    throw std::runtime_error(std::string("Cannot create GP01 score file: ") + path);
+  }
+  output << "edge_id,source,target,score\n" << std::setprecision(std::numeric_limits<float>::max_digits10);
+  for (HyperedgeID edge_id = 0; edge_id < graph.initialNumEdges(); ++edge_id) {
+    output << edge_id << ',' << graph.edgeSource(edge_id) << ',' << graph.edgeTarget(edge_id)
+           << ',' << metadata[edge_id] << '\n';
+  }
+  output.close();
+  if (!output) {
+    throw std::runtime_error(std::string("Failed writing GP01 score file: ") + path);
+  }
+}
