      {
        "line": 1,
        "text": "\"\"\"Same physical controller and feedback; explicit order/parameter interventions.\"\"\""
      },
      {
        "line": 3,
        "text": "import hashlib,importlib.util,time"
      },
      {
        "line": 10,
        "text": "  # Fixed global priority, independent of call count, state outcomes and week."
      },
      {
        "line": 15,
        "text": "  for ends in [env.line_or_to_subid,env.line_ex_to_subid]:np.maximum.at(pressure,ends[live],obs.rho[live])"
      },
      {
        "line": 21,
        "text": "  t=time.perf_counter();order=expected_order(item,reps,self.subids,obs,self.env)"
      },
      {
        "line": 22,
        "text": "  return order,None,None,dict(feature_s=0.,prior_s=0.,forward_rank_s=time.perf_counter()-t)"
      },
      {
        "line": 23,
        "text": " def choose(self,obs,base,reward,done=False,**kwargs):"
      },
      {
        "line": 24,
        "text": "  start=time.perf_counter();eligible,reps,aliases,actions,changed=self.prepare(obs,base);prepared=time.perf_counter()"
      },
      {
        "line": 25,
        "text": "  order,prior,features,times=rank(self,obs,base,eligible,reps,aliases);limit=min(float(obs.rho.max()),float(kwargs.get('rho_threshold',obs.rho.max())))"
      },
      {
        "line": 29,
        "text": "   assert i not in cache;t=time.perf_counter();future,rr,ended,info=obs.simulate(actions[i]+base);forecast_s+=time.perf_counter()-t"
      },
      {
        "line": 30,
        "text": "   f=flags(info);rho=float(future.rho.max());valid=bool(0<rho<limit and not ended and not f['exceptions'] and not f['illegal'] and not f['ambiguous'])"
      },
      {
        "line": 31,
        "text": "   r=dict(pool_id=i,rho=rho,reward=float(rr),done=bool(ended),**f,strict_admissible=valid,forecast_s=time.perf_counter()-t,phase=phase);cache[i]=r;return r"
      },
      {
        "line": 38,
        "text": "  reason='no_admissible_shortlist' if prefix is None else 'shortlist_above_author_safe' if cache[prefix]['rho']>=safe else 'shortlist_below_author_safe'"
      },
      {
        "line": 39,
        "text": "  log=dict(rule=self.rule,policy=self.policy,budget=(item.get('parameters') or {}).get('p',128),eligible=eligible,representatives=reps,aliases=aliases,order=order,order_mode=item.get('order_mode','STATIC_ID'),shortlist=order[:(item.get('parameters') or {}).get('p',128)],masked_ids=changed,rho_limit=limit,guard_rho=safe,guard_reason=reason,**result,source_s=time.perf_counter()-start,prepare_s=prepared-start,forecast_s=forecast_s,**times)"
      },
      {
        "line": 40,
        "text": "  chosen=result['chosen_pool_id'];return None if chosen is None else actions[chosen],log,features,prior"
      }
    ]
